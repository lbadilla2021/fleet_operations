#. module: fleet_operations
#: model:mail.template,body_html:fleet_operations.fleet_email_template
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Dear<t t-out=\"object.driver_id.name or ''\"/>,\n"
"                    <br/>\n"
"                    <br/>\n"
"                    We understand that you might have a busy schedule and we would like to kindly set a reminder for\n"
"                    you.\n"
"                </p>\n"
"                <p>\n"
"                    We have would like to remind you that your vehicle\n"
"                    <b>\n"
"                        <t t-out=\"object.name or ''\"/>\n"
"                    </b>\n"
"                    service falls due on<t t-out=\"object.next_service_date or ''\"/>.\n"
"                    <br/>\n"
"                    Thank you.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Estimado/a <t t-out=\"object.driver_id.name or ''\"/>,\n"
"                    <br/>\n"
"                    <br/>\n"
"                    Entendemos que puede tener una agenda ocupada y queremos dejarle un recordatorio\n"
"                    amable.\n"
"                </p>\n"
"                <p>\n"
"                    Queremos recordarle que su vehículo\n"
"                    <b>\n"
"                        <t t-out=\"object.name or ''\"/>\n"
"                    </b>\n"
"                    tiene servicio programado para el <t t-out=\"object.next_service_date or ''\"/>.\n"
"                    <br/>\n"
"                    Gracias.\n"
"                </p>\n"
"            </div>\n"
"        "

